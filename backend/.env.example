# --- LLM: any OpenAI-compatible local server (provider chosen here, not in code) ---
# Ollama:        LLM_BASE_URL=http://localhost:11434/v1   (model = an Ollama tag)
# llama.cpp:     LLM_BASE_URL=http://localhost:8080/v1    (llama-server --api ...)
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=local-model
LLM_API_KEY=not-needed

# --- Graph / Vector (Docker Compose) — wired in at later phases ---
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=change-me
# CHROMA_HOST=localhost
# CHROMA_PORT=8000

# --- Jira connector (v1 source) — wired in at P4 ---
# JIRA_BASE_URL=https://your-org.atlassian.net
# JIRA_EMAIL=you@org.com
# JIRA_API_TOKEN=...
